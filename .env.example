# =============================================================================
# Medaf Wholesale Backend - Environment Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in your actual credentials.

# -----------------------------------------------------------------------------
# 1. Server & Environment
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Option A: Full Connection URL (e.g. Supabase, Neon, Render)
DATABASE_URL=

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medaf_skincare

# -----------------------------------------------------------------------------
# 3. Authentication & JWT Secrets
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string
JWT_EXPIRES_IN=7d
CUSTOMER_JWT_SECRET=replace_with_a_secure_random_string

# -----------------------------------------------------------------------------
# 4. Telegram Bot & WebApp
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_ADMIN_PASSWORD=adminpass123
SHOP_WEBAPP_URL=http://localhost:3000/shop
SHOP_MINI_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5. Media Uploads (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# 6. Delivery Distance & Geocoding (LocationIQ)
# -----------------------------------------------------------------------------
LOCATIONIQ_API_KEY=

# -----------------------------------------------------------------------------
# 7. AI & Optical Character Recognition (OCR)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AMHARIC_TRANSLATION=false

# -----------------------------------------------------------------------------
# 8. Payment Verification (Verify.ET)
# -----------------------------------------------------------------------------
VERIFY_ET_API_KEY=
VERIFY_ET_BASE_URL=https://verify.et/api/v1
VERIFY_ET_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 9. Initial Seed Data
# -----------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@medaf.com
ADMIN_PASSWORD=AdminPassword123!
SUPPORT_PHONE=+251911000000

